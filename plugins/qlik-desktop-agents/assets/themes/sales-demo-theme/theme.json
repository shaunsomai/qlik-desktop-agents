{
  "_comment": "Palette validated with the dataviz validator against Qlik's white chart surface. Categorical: 8 slots, fixed row order, all checks pass on the adjacent pairlist. See THEME-NOTES.md in the repo for the validator output and the 3-slot cap for treemaps and scatter plots.",

  "_variables": {
    "@surface": "#ffffff",
    "@ink-primary": "#0b0b0b",
    "@ink-secondary": "#52514e",
    "@ink-muted": "#898781",
    "@gridline": "#e1e0d9",
    "@baseline": "#c3c2b7",
    "@others": "#898781",
    "@null": "#e1e0d9",
    "@critical": "#d03b3b",

    "@font-title": "15px",
    "@font-body": "13px",
    "@font-axis": "12px",
    "@font-small": "11px"
  },

  "backgroundColor": "@surface",
  "fontFamily": "Source Sans Pro, system-ui, -apple-system, Segoe UI, sans-serif",
  "fontSize": "@font-body",
  "color": "@ink-secondary",

  "dataColors": {
    "primaryColor": "#2a78d6",
    "othersColor": "@others",
    "errorColor": "@critical",
    "nullColor": "@null"
  },

  "palettes": {
    "data": [
      {
        "name": "Sales 8 (validated)",
        "type": "row",
        "scale": [
          "#2a78d6",
          "#eb6834",
          "#1baf7a",
          "#eda100",
          "#e87ba4",
          "#008300",
          "#4a3aa7",
          "#e34948"
        ]
      },
      {
        "name": "Core 3 (all-pairs safe)",
        "type": "row",
        "scale": [
          "#2a78d6",
          "#eb6834",
          "#1baf7a"
        ]
      }
    ],
    "ui": [
      {
        "name": "Palette",
        "colors": [
          "#ffffff",
          "#2a78d6",
          "#eb6834",
          "#1baf7a",
          "#eda100",
          "#e87ba4",
          "#008300",
          "#4a3aa7",
          "#e34948",
          "#0d366b",
          "#e1e0d9",
          "#898781",
          "#52514e",
          "#0b0b0b"
        ]
      }
    ]
  },

  "scales": [
    {
      "name": "Magnitude (blue)",
      "translation": "Magnitude (blue)",
      "type": "gradient",
      "propertyValue": "magnitude-gradient",
      "scale": [
        "#cde2fb",
        "#9ec5f4",
        "#6da7ec",
        "#3987e5",
        "#256abf",
        "#184f95",
        "#0d366b"
      ]
    },
    {
      "name": "Magnitude classes",
      "translation": "Magnitude classes",
      "type": "class",
      "propertyValue": "magnitude-classes",
      "scale": [
        "#86b6ef",
        "#5598e7",
        "#2a78d6",
        "#1c5cab",
        "#104281"
      ]
    },
    {
      "name": "Variance (red to blue)",
      "translation": "Variance (red to blue)",
      "type": "gradient",
      "propertyValue": "variance-gradient",
      "scale": [
        "#a32423",
        "#d03b3b",
        "#ef8a89",
        "#f0efec",
        "#86b6ef",
        "#2a78d6",
        "#104281"
      ]
    },
    {
      "name": "Variance classes",
      "translation": "Variance classes",
      "type": "class",
      "propertyValue": "variance-classes",
      "scale": [
        "#d03b3b",
        "#ef8a89",
        "#f0efec",
        "#86b6ef",
        "#2a78d6"
      ]
    }
  ],

  "object": {
    "title": {
      "main": { "color": "@ink-primary", "fontSize": "@font-title" },
      "subTitle": { "color": "@ink-muted", "fontSize": "@font-axis" },
      "footer": { "color": "@ink-muted", "fontSize": "@font-axis", "backgroundColor": "transparent" }
    },
    "axis": {
      "title": { "color": "@ink-muted", "fontSize": "@font-axis" },
      "label": { "name": { "color": "@ink-secondary", "fontSize": "@font-axis" } },
      "line": {
        "major": { "color": "@baseline" },
        "minor": { "color": "@gridline" }
      }
    },
    "grid": {
      "line": {
        "highContrast": { "color": "@baseline" },
        "major": { "color": "@gridline" },
        "minor": { "color": "@gridline" }
      }
    },
    "legend": {
      "title": { "color": "@ink-secondary", "fontSize": "@font-body" },
      "label": { "color": "@ink-secondary", "fontSize": "@font-axis" }
    },
    "label": {
      "name": { "color": "@ink-primary", "fontSize": "@font-body" },
      "value": { "color": "@ink-primary", "fontSize": "@font-body" }
    },
    "referenceLine": {
      "label": { "name": { "color": "@ink-primary" } },
      "outOfBounds": { "color": "@ink-muted", "backgroundColor": "@gridline" }
    },
    "kpi": {
      "label": {
        "name": { "color": "@ink-muted", "fontSize": "@font-axis" },
        "value": { "color": "@ink-primary" }
      }
    },
    "barChart": {
      "outOfRange": { "color": "@ink-muted" },
      "label": { "value": { "color": "@ink-secondary", "fontSize": "@font-small" } }
    },
    "lineChart": {
      "outOfRange": { "color": "@ink-muted" },
      "label": { "value": { "color": "@ink-secondary", "fontSize": "@font-axis" } }
    },
    "comboChart": {
      "outOfRange": { "color": "@ink-muted" },
      "label": { "value": { "color": "@ink-secondary", "fontSize": "@font-small" } }
    },
    "scatterPlot": {
      "label": { "value": { "color": "@ink-secondary", "fontSize": "@font-small" } }
    },
    "treemap": {
      "branch": {
        "backgroundColor": ".alpha(5)",
        "label": { "color": ".inherit()", "fontSize": "@font-body" }
      },
      "leaf": { "label": { "fontSize": "@font-axis" } }
    },
    "straightTable": {
      "totals": { "label": { "color": "@ink-primary" } },
      "header": { "label": { "color": "@ink-secondary" } }
    },
    "pivotTable": {
      "totals": { "label": { "color": "@ink-primary" } },
      "header": { "label": { "color": "@ink-secondary" } },
      "nullValue": { "label": { "color": "@ink-muted" } }
    },
    "listBox": {
      "content": { "color": "@ink-primary", "fontSize": "@font-body" },
      "title": { "main": { "color": "@ink-secondary", "fontSize": "@font-axis" } }
    }
  }
}
